# GitBot local configuration.
# Copy to `.env` and adjust. `.env` is gitignored.
# This file must never contain real secrets, tokens, or keys.

# Local API bind (localhost only by policy)
GITBOT_HOST=127.0.0.1
GITBOT_PORT=8765

# Logging
GITBOT_LOG_LEVEL=INFO

# Mutating operations stay in dry-run unless explicitly disabled per action.
# Global dry-run must remain true by default.
GITBOT_DRY_RUN=true

# Supervised daily automation: when true, the scheduler may execute sandboxed
# change lanes (including write task types) to produce diffs/tests/awaiting
# review while global dry-run remains enabled. It never auto-approves or
# auto-commits. Keep disabled by default.
GITBOT_SUPERVISED_AUTOMATION_ENABLED=false

# Approved local commits: when true together with supervised automation, a
# valid user-approved task may be committed locally through the explicit
# approval workflow even while global dry-run remains enabled. No automatic
# commit, no push, no PR. Keep disabled by default.
GITBOT_ALLOW_APPROVED_LOCAL_COMMITS=false

# Path to the local API token file (created with 0600).
# The token value itself is never written here.
GITBOT_TOKEN_FILE=~/.config/gitbot/token

# Host-side AI gateway. The repository sandbox has no direct network; it reaches
# this authenticated loopback gateway over a single bind-mounted Unix socket.
# The host model runner is itself sandboxed and may only use an allowlisted
# CONNECT tunnel to *.opencode.ai:443. No provider credential enters /repo.
GITBOT_AI_GATEWAY_ENABLED=true
GITBOT_AI_GATEWAY_MODEL=opencode/inkling-2-small-free
GITBOT_AI_GATEWAY_TIMEOUT_S=120
GITBOT_AI_GATEWAY_RELAY_PORT=18080

# Opt-in scheduler (process-local, interval-based).
GITBOT_SCHEDULER_ENABLED=false
GITBOT_SCHEDULER_INTERVAL_S=30
# Delay before a manually created retry becomes due. 0 = retry immediately.
GITBOT_RETRY_DELAY_S=30
